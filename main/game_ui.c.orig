static lv_obj_t *ambient_particles[PP_SCENE_FX_MAX][2];
static void ambient_update(uint32_t elapsed) {
  pp_scene_particle particles[PP_SCENE_FX_MAX];
  unsigned count=pp_scene_fx_sample(g->scene,ambient_seed,elapsed,ambient_preview,particles);
  for(unsigned i=0;i<PP_SCENE_FX_MAX;i++) for(unsigned part=0;part<2;part++) {
    lv_obj_t *o=ambient_particles[i][part];
    if(i>=count || (part && !particles[i].cross)) {lv_obj_add_flag(o,LV_OBJ_FLAG_HIDDEN);continue;}
    const pp_scene_particle *p=&particles[i];
    lv_obj_set_pos(o,p->x+(p->cross&&part?p->w/2:0),p->y+(p->cross&&!part?p->h/2:0));
    lv_obj_set_size(o,p->cross?(part?1:p->w):p->w,p->cross?(part?p->h:1):p->h);
    lv_obj_set_style_bg_color(o,lv_color_hex(p->color),0);
    lv_obj_set_style_bg_opa(o,p->opacity,0);
    lv_obj_remove_flag(o,LV_OBJ_FLAG_HIDDEN);
  }
}
