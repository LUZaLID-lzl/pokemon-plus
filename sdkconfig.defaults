# Hardware defaults from Waveshare 02_lvgl_demo at 139e6db; see docs/HARDWARE.md.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# Software choices: dedicated small app, native USB console, LVGL 9 fonts.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# Official example sdkconfig explicitly uses 80MHz flash.
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_LV_USE_LZ4=y
CONFIG_LV_USE_LZ4_INTERNAL=y

CONFIG_LV_BIN_DECODER_RAM_LOAD=y

CONFIG_LV_CACHE_DEF_SIZE=524288

CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=64

# Software-only code-size optimization; ESP-IDF Kconfig COMPILER_OPTIMIZATION_SIZE (-Os).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Application software configuration, no changes to official hardware timing.
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH=""
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
# CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL is not set
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_28=y

CONFIG_SPIFFS_OBJ_NAME_LEN=64
