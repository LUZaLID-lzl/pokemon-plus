#include <windows.h>
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/windows.ico"
1 VERSIONINFO
 FILEVERSION @PP_VERSION_COMMAS@,0
 PRODUCTVERSION @PP_VERSION_COMMAS@,0
 FILETYPE VFT_APP
 FILEOS VOS_NT_WINDOWS32
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Pokemon Plus Simulator\0"
   VALUE "FileVersion", "@PP_VERSION@\0"
   VALUE "ProductName", "Pokemon Plus\0"
   VALUE "ProductVersion", "@PP_VERSION@\0"
   VALUE "OriginalFilename", "PokemonPlus.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
